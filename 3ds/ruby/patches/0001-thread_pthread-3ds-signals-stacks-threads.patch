thread_pthread.c for newlib without sigaction (Nintendo 3DS):
- posix_signal() only exists with POSIX_SIGNAL; fall back to signal().
- Main-thread stack size: no getrlimit/pthread_getattr_np, so take libctru's __stacksize__
  (the app may override the weak symbol) minus a 64 KiB margin. Without it stack_maxsize
  stays 0 and machine-stack overflow checks never fire.
- Threads: set the pthread stack size (no PTHREAD_STACK_MIN in newlib; libctru default 32 KiB)
  and take a non-main thread's stack start from its first frame instead of raising
  NotImplementedError (which killed every new Thread before it held the GVL).
- New threads get the creating thread's priority (rb3ds_thread_created, shim): libctru creates
  pthreads at the lowest priority, and the 3DS never runs them while a higher one is runnable.
- native_thread_yield() calls rb3ds_yield() (shim): newlib's sched_yield() is an ENOSYS stub.

--- a/thread_pthread.c
+++ b/thread_pthread.c
@@ -188,7 +188,12 @@
 static const rb_thread_t *sigwait_th;
 
 #ifdef HAVE_SCHED_YIELD
+#ifdef __3DS__
+/* newlib's sched_yield() is an ENOSYS stub on devkitARM (see 3ds/ruby/shim) */
+#define native_thread_yield() rb3ds_yield()
+#else
 #define native_thread_yield() (void)sched_yield()
+#endif
 #else
 #define native_thread_yield() ((void)0)
 #endif
@@ -659,7 +664,11 @@
     ruby_thread_set_native(th);
     fill_thread_id_str(th);
     native_thread_init(th);
+#ifdef POSIX_SIGNAL
     posix_signal(SIGVTALRM, null_func);
+#else
+    signal(SIGVTALRM, null_func); /* newlib without sigaction (Nintendo 3DS) */
+#endif
 }
 
 #ifdef RB_THREAD_T_HAS_NATIVE_ID
@@ -961,6 +970,14 @@
 	    space = (size_t)addr - ((size_t)((char *)addr - size) / pagesize + 1) * pagesize;
 	}
 	native_main_thread.stack_maxsize = space;
+#elif defined(__3DS__)
+	/* Nintendo 3DS (libctru): main() runs on a stack of __stacksize__ bytes, a weak symbol
+	 * the application may override. stack_start (set above from RUBY_INIT_STACK) lies close
+	 * to its top; keep a margin for the frames above it and for C code beyond Ruby's checks. */
+	extern uint32_t __stacksize__;
+	size_t size = (size_t)__stacksize__;
+	const size_t margin = 64 * 1024;
+	native_main_thread.stack_maxsize = size > 2 * margin ? size - margin : size / 2;
 #endif
     }
 
@@ -1012,6 +1029,11 @@
 	    th->ec->machine.stack_start = (VALUE *)&curr;
 	    th->ec->machine.stack_maxsize = size - diff;
 	}
+#elif defined(__3DS__)
+	/* Nintendo 3DS: no way to query a thread's stack, but native_thread_create sized it and set
+	 * machine.stack_maxsize (with a safety space); this frame is close to its top. Raising here
+	 * (the generic branch) would kill the new thread before it holds the GVL. */
+	th->ec->machine.stack_start = (VALUE *)&curr;
 #else
 	rb_raise(rb_eNotImpError, "ruby engine can initialize only in the main thread");
 #endif
@@ -1184,7 +1206,9 @@
 
 	CHECK_ERR(pthread_attr_init(&attr));
 
-# ifdef PTHREAD_STACK_MIN
+# if defined(PTHREAD_STACK_MIN) || defined(__3DS__)
+	/* Nintendo 3DS: newlib has no PTHREAD_STACK_MIN, but without a size libctru gives the thread
+	 * 32 KiB while machine.stack_maxsize above assumes stack_size. */
 	thread_debug("create - stack size: %lu\n", (unsigned long)stack_size);
 	CHECK_ERR(pthread_attr_setstacksize(&attr, stack_size));
 # endif
@@ -1195,6 +1219,9 @@
 	CHECK_ERR(pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED));
 
         err = pthread_create(&th->thread_id, &attr, thread_start_func_1, th);
+#ifdef __3DS__
+	if (err == 0) rb3ds_thread_created(th->thread_id); /* see 3ds/ruby/shim/include/rb3ds_compat.h */
+#endif
 	thread_debug("create: %p (%d)\n", (void *)th, err);
 	/* should be done in the created thread */
 	fill_thread_id_str(th);
